{
	"buildCommand": "npm run build",
	"devCommand": "npm run dev",
	"installCommand": "npm install",
	"framework": "vite",
	"outputDirectory": "dist",
	"functions": {
		"api/*.js": {
			"memory": 1024,
			"maxDuration": 60
		}
	},
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": "/api/$1"
		},
		{
			"source": "/(.*)",
			"destination": "/"
		}
	]
}
